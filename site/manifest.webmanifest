{
  "name": "Interaktive Wandtafel",
  "short_name": "Wandtafel",
  "description": "Fächer, Kapitel und Tafeln für den Unterricht. Läuft auch ohne Internet.",
  "lang": "de-CH",
  "id": "./",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#eef2f6",
  "theme_color": "#21295c",
  "icons": [
    { "src": "bilder/symbol-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "bilder/symbol-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "bilder/symbol-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "bilder/symbol.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "application/vnd.openxmlformats-officedocument.presentationml.presentation": [".pptx"]
      }
    }
  ]
}
